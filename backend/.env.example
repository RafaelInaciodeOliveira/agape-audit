# Porta onde o backend vai rodar
PORT=3001

# MongoDB Atlas
MONGODB_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/agape_audit?retryWrites=true&w=majority"

# Token do Umbler (Configurações > Integrações > API na Umbler UTalk)
UMBLER_TOKEN=""

# ID da Organização na Umbler
UMBLER_ORGANIZATION_ID=""

# ID da Base de Conhecimento onde os Q&As gerados na auditoria são salvos
UMBLER_KB_ID=""

# [OBRIGATÓRIO] ID do agente de IA (Ágape) na Umbler; também é o id de membro usado para achar
# as respostas dele. Sem ele o servidor não inicia.
UMBLER_AGENT_ID=""

# --- Painel de Custos de IA (FinOps) ---
# Valor de 1 unidade de crédito da API da Umbler, na moeda de FINOPS_CURRENCY.
# A API usa 1/10.000 do crédito do painel (645 por resposta de texto = R$ 0,0645).
UMBLER_CREDIT_VALUE=0.0001
FINOPS_CURRENCY="BRL"
# Intervalo (minutos) da importação automática do consumo do Ágape; 0 desliga
FINOPS_SYNC_INTERVAL_MIN=15

# Segredo opcional do webhook do Strapi. Se definido, o Strapi precisa enviar
# o header "Authorization: Bearer <valor>" (configurado no próprio webhook no Strapi)
STRAPI_WEBHOOK_SECRET=""

# --- Autenticação ---
# Credenciais do login da aplicação (validadas pelo backend em POST /api/login)
ADMIN_USER="Admin.Agape"
ADMIN_PASS=""
# Segredo para assinar os JWTs de sessão (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Origem(ns) do frontend liberadas no CORS, separadas por vírgula
FRONTEND_URL="http://localhost:3000"
# Defina quando o backend roda atrás de proxy reverso (Nginx, Render, Railway...),
# para o rate limit do login enxergar o IP real do cliente. Ex.: 1 (um proxy na frente)
TRUST_PROXY=""
